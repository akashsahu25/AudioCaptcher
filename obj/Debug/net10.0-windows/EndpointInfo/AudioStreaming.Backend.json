{
  "openapi": "3.1.1",
  "info": {
    "title": "AudioStreaming.Backend | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://localhost:7056"
    },
    {
      "url": "http://localhost:5165"
    }
  ],
  "paths": {
    "/api/audio/devices": {
      "get": {
        "tags": [
          "AudioCapture"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/audio/processes": {
      "get": {
        "tags": [
          "AudioCapture"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/audio/sessions": {
      "get": {
        "tags": [
          "AudioCapture"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/audio/sessions/{id}": {
      "get": {
        "tags": [
          "AudioCapture"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/audio/start": {
      "post": {
        "tags": [
          "AudioCapture"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartCaptureRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/StartCaptureRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/StartCaptureRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/audio/sessions/{id}/stop": {
      "post": {
        "tags": [
          "AudioCapture"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/audio/sessions/{sessionId}/chunks": {
      "get": {
        "tags": [
          "AudioChunks"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/audio/sessions/{sessionId}/chunks/{sequence}": {
      "get": {
        "tags": [
          "AudioChunks"
        ],
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "sequence",
            "in": "path",
            "required": true,
            "schema": {
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "StartCaptureRequest": {
        "required": [
          "processId"
        ],
        "type": "object",
        "properties": {
          "processId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "AudioCapture"
    },
    {
      "name": "AudioChunks"
    }
  ]
}