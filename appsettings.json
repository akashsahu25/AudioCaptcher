{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "BrowserOrigins": [],
  "AudioMedia": {
    "LibraryRoot": ""
  },
  "PlaybackAutomation": {
    "Targets": {
      "vlc": {
        "Kind": "Vlc",
        "ExecutablePath": "",
        "MediaPath": "",
        "RequestTimeoutSeconds": 10
      }
    }
  },
  "AudioCapture": {
    "StartThresholdDbfs": -60,
    "StartConfirmationMs": 100,
    "SilenceTimeoutSeconds": 10,
    "DedicatedOutputs": {
      "primary": ""
    }
  }
}
